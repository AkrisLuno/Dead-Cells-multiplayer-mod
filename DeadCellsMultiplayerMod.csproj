<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ModType>mod</ModType>
    <ModMain>DeadCellsMultiplayerMod.ModEntry</ModMain>
    <Version>0.1.0</Version>
    <AutoInstallMod>false</AutoInstallMod>
    <RestoreAdditionalProjectSources Condition="'$(DCCM_MDK_ROOT)' != ''">$(RestoreAdditionalProjectSources);$(DCCM_MDK_ROOT)/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CoopQa)' == 'true'">
    <DefineConstants>$(DefineConstants);COOP_QA</DefineConstants>
  </PropertyGroup>
</Project>
